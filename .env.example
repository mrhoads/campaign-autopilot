# ---------------------------------------------------------------------------
# Campaign Autopilot — Environment Variables
# ---------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in the values from your Azure
# AI Foundry project.
# ---------------------------------------------------------------------------

# --- Azure endpoint ---------------------------------------------------------
#
# Two endpoint shapes are supported automatically:
#
#   Foundry v1 (modern; required for gpt-image-2, sora-2, gpt-4.1):
#     https://<resource>.openai.azure.com/openai/v1
#
#   Classic Azure OpenAI:
#     https://<resource>.openai.azure.com
#
# The code detects which one based on whether the URL ends with /openai/v1.

AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE-NAME.openai.azure.com/openai/v1

# --- Authentication --------------------------------------------------------
#
# Two options. Pick ONE.
#
#   OPTION A — Microsoft Entra ID (recommended; required if your tenant has
#   disabled API keys, which is common in enterprise Foundry tenants):
#
#     Leave AZURE_OPENAI_API_KEY blank below. Run `az login` once on the
#     machine running the app. Your account needs the role
#     "Cognitive Services OpenAI User" (or higher) on the resource.
#     DefaultAzureCredential will pick up your CLI login automatically.
#
#   OPTION B — API key (only if keys are enabled on your resource):
#     Paste the key below.

AZURE_OPENAI_API_KEY=

# --- Deployment names (must match what you named them in Foundry) ----------
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4.1
AZURE_OPENAI_IMAGE_DEPLOYMENT=gpt-image-2
AZURE_OPENAI_VIDEO_DEPLOYMENT=sora-2

# --- API versions (defaults are correct for the Foundry v1 endpoint) -------
AZURE_OPENAI_API_VERSION=preview
AZURE_OPENAI_IMAGE_API_VERSION=preview
AZURE_OPENAI_VIDEO_API_VERSION=preview

# --- Feature flags (optional) ----------------------------------------------
DISABLE_IMAGE_GENERATION=false
DISABLE_VIDEO_GENERATION=false
